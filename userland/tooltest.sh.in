#!/bin/sh
# tooltest.sh — guest 内工具链验收脚本(仅 toolchain-verify.sh 注入的构建会带)
# 验收: gcc/clang 各编译 C(动态) + C++(静态) 并运行产物。
#   gcc: -B 双前缀(包内 libexec 找 cc1/collect2/as/ld) + -I 包内私头 + -L 包内 lib
#   clang: --gcc-toolchain 指包内 gcc-15(驱动探测到包内布局, crt/libgcc 用包内路径)
#   动态产物 -Wl,-rpath-link/-rpath 指包内 lib(NEEDED 定位), 运行靠
#   /lib64/ld-linux(INTERP)+ LD_LIBRARY_PATH(init 已设)+ 包内全部 .so。
# 全过 TC_ALL_OK, 否则 TC_FAIL。

G15=/opt/toolchain/gcc-15
LX="$G15/libexec/gcc/x86_64-linux-gnu/15"
LIB="/lib/toolchain"
L15="$G15/lib/gcc/x86_64-linux-gnu/15"
GI="-I$G15/include"
GB="gcc -B$LX -B$G15/bin $GI -L $LIB -L $L15 -L $G15/bin"
CB="g++ -B$LX -B$G15/bin $GI -L $LIB -L $L15 -L $G15/bin"
CC="clang --gcc-toolchain=$G15 $GI -L $LIB -L $L15 -L $G15/lib -Wl,-rpath-link,$LIB -Wl,-rpath-link,$L15 -Wl,-rpath,$LIB -Wl,-rpath,$L15"

echo "=== tooltest: 版本 ==="
gcc --version 2>&1 | head -1
g++ --version 2>&1 | head -1
clang --version 2>&1 | head -1
llvm-config --version 2>&1

FAIL=0

# 源码(printf 生成, 不用 heredoc: WSL 宿主中间层会吞 heredoc 产生 0 字节源文件)
printf '#include <stdio.h>\nint main(){ printf("C_dyn_ok\\n"); return 0; }\n' > /tmp/tc_c.c
printf '#include <iostream>\nint main(){ std::cout << "CPP_static_ok" << std::endl; return 0; }\n' > /tmp/tc_cpp.cpp
[ "$(wc -c < /tmp/tc_c.c)" -gt 30 ] || { echo "TC_SRC_FAIL tc_c.c=$(wc -c < /tmp/tc_c.c)"; exit 1; }
[ "$(wc -c < /tmp/tc_cpp.cpp)" -gt 30 ] || { echo "TC_SRC_FAIL tc_cpp.cpp=$(wc -c < /tmp/tc_cpp.cpp)"; exit 1; }

# 1. gcc 动态 C(包内 binutils 链接 + 显式 libc: 默认链接器出的产物
# NEEDED 缺 libc.so.6, 动态装载器起不来 SEGV; -l:libc.so.6 补 NEEDED)
if $GB -l:libc.so.6 -Wl,-rpath,$LIB -o /tmp/tc_cdyn /tmp/tc_c.c 2>/tmp/tc_err1; then
  if /tmp/tc_cdyn >/tmp/tc_cdyn.out 2>&1 && grep -q C_dyn_ok /tmp/tc_cdyn.out; then
    echo "gcc C dyn: PASS"
  else
    echo "gcc C dyn: FAIL (产物跑不起来)"; cat /tmp/tc_cdyn.out; tail -3 /tmp/tc_err1; FAIL=1
  fi
else
  echo "gcc C dyn: FAIL (编译)"; tail -5 /tmp/tc_err1; FAIL=1
fi

# 2. gcc 静态 C++
if $CB -B$LIB -static -fno-pie -o /tmp/tc_cppst /tmp/tc_cpp.cpp 2>/tmp/tc_err2; then
  if /tmp/tc_cppst >/tmp/tc_cppst.out 2>&1 && grep -q CPP_static_ok /tmp/tc_cppst.out; then
    echo "g++ C++ static: PASS"
  else
    echo "g++ C++ static: FAIL"; cat /tmp/tc_cppst.out; tail -3 /tmp/tc_err2; FAIL=1
  fi
else
  echo "g++ C++ static: FAIL (编译)"; tail -5 /tmp/tc_err2; FAIL=1
fi

# 3. clang 动态 C(包内 binutils 链接 + 显式 libc, 同 gcc dyn 的 NEEDED 修复)
if $CC -B$LIB -fuse-ld=bfd -l:libc.so.6 -o /tmp/tc_ccdyn /tmp/tc_c.c 2>/tmp/tc_err3; then
  if /tmp/tc_ccdyn >/tmp/tc_ccdyn.out 2>&1 && grep -q C_dyn_ok /tmp/tc_ccdyn.out; then
    echo "clang C dyn: PASS"
  else
    echo "clang C dyn: FAIL"; cat /tmp/tc_ccdyn.out; tail -3 /tmp/tc_err3; FAIL=1
  fi
else
  echo "clang C dyn: FAIL (编译)"; tail -5 /tmp/tc_err3; FAIL=1
fi

# 4. clang 静态 C
if $CC -B$LIB -static -fno-pie -o /tmp/tc_cst /tmp/tc_c.c 2>/tmp/tc_err4; then
  if /tmp/tc_cst >/tmp/tc_cst.out 2>&1 && grep -q C_dyn_ok /tmp/tc_cst.out; then
    echo "clang C static: PASS"
  else
    echo "clang C static: FAIL"; cat /tmp/tc_cst.out; tail -3 /tmp/tc_err4; FAIL=1
  fi
else
  echo "clang C static: FAIL (编译)"; tail -5 /tmp/tc_err4; FAIL=1
fi

echo "=== 动态产物 rpath ==="
readelf -d /tmp/tc_cdyn 2>/dev/null | grep -E "RPATH|RUNPATH|NEEDED" | head -5 || \
  strings /tmp/tc_cdyn 2>/dev/null | grep -m1 "ld-linux"

echo "=== 相对路径 execve 验收(用户报 ./gcc ./c++ 失败) ==="
cd /bin
echo "PWD=$(pwd)"
ls -la /bin/gcc /bin/c++ 2>&1 | head -4
echo "--- 宿主侧 stat 软链链:"
ls -la /usr/bin/gcc /usr/bin/c++ 2>&1 | head -4
./gcc --version 2>&1 | head -1 && echo "./gcc: PASS" || echo "./gcc: FAIL"
./c++ --version 2>&1 | head -1 && echo "./c++: PASS" || echo "./c++: FAIL"
gcc --version 2>&1 | head -1 && echo "gcc(PATH): PASS" || echo "gcc(PATH): FAIL"

[ "$FAIL" -eq 0 ] && echo "TC_ALL_OK" || echo "TC_FAIL"
